\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preamble}

% --- Maths ---
\RequirePackage{amsmath, amssymb}
\RequirePackage{amsthm}
\RequirePackage{thmtools}

% --- Links and references (hyperref must come before cleveref) ---
\RequirePackage{xcolor}
\RequirePackage[colorlinks=true, urlcolor= blue, linkcolor=black, citecolor=teal]{hyperref}
\RequirePackage[capitalise, nameinlink]{cleveref}

% --- Bibliography ---
\RequirePackage[backend=biber, style=alphabetic]{biblatex}
\addbibresource{refs.bib}

\RequirePackage{enumitem}   % for (a), (b) labels in lists

% --- Environments ---
% Exercises: the number is given by hand, so it always matches the book
\declaretheorem[style=definition, name=Exercise]{bookexercise}
\crefname{bookexercise}{Exercise}{Exercises}
\newenvironment{exercise}[1]
  {\renewcommand{\thebookexercise}{#1}\bookexercise}
  {\endbookexercise}

\declaretheorem[style=plain, numberwithin=chapter]{theorem}
\declaretheorem[style=plain, sibling=theorem]{lemma}
\declaretheorem[style=definition, sibling=theorem]{definition}
\declaretheorem[style=remark, numbered=no]{remark}

% Chapters with the book's numbering: \bookchapter{3}{Title}
\newcommand{\bookchapter}[2]{%
  \setcounter{chapter}{\numexpr#1-1\relax}\chapter{#2}}

% --- Macros ---
\newcommand{\F}{\mathbb{F}}
